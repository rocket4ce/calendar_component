<Layouts.app flash={@flash}>
  <div class="mx-auto max-w-5xl space-y-4">
    <header class="space-y-1">
      <h1 class="text-2xl font-semibold">Static calendar</h1>
      <p class="text-sm opacity-70">
        Rendered by a regular controller. Callbacks are global JavaScript functions
        (<code>CalendarDemo.Static.*</code>, defined in <code>assets/js/app.js</code>).
      </p>
    </header>

    <div id="static-log" class="rounded bg-base-200 p-3 text-sm font-mono" data-log="">
      no interaction yet
    </div>

    <LiveCalendar.Components.static_calendar
      id="static-calendar"
      class="rounded border p-2"
      events={@events}
      options={
        %{
          view: "dayGridMonth",
          firstDay: 1,
          eventClick: "CalendarDemo.Static.onEventClick",
          dateClick: "CalendarDemo.Static.onDateClick",
          datesSet: "CalendarDemo.Static.onRangeChange",
          headerToolbar: %{
            start: "prev,next today",
            center: "title",
            end: "dayGridMonth,timeGridWeek,listWeek"
          }
        }
      }
    />
  </div>
</Layouts.app>
